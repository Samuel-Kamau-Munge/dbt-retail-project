retail:
  target: dev
  outputs:
    dev:
      type: postgres
      host: localhost
      port: 5432
      user: postgres
      pass: "{{ env_var('DBT_POSTGRES_PASSWORD') }}"
      dbname: retail_db
      schema: public
      threads: 4
      connect_timeout: 10
      retries: 2

    prod:
      type: postgres
      host: "{{ env_var('DBT_PROD_HOST') }}"
      port: 5432
      user: "{{ env_var('DBT_PROD_USER') }}"
      pass: "{{ env_var('DBT_PROD_PASSWORD') }}"
      dbname: retail_db
      schema: public
      threads: 8
      connect_timeout: 10
      retries: 3
